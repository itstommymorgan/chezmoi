#!/usr/bin/env zsh

SOCKET="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

if [ ! -S "$SOCKET" ]; then
  echo "1Password SSH agent socket not found."
  echo "Opening 1Password settings..."

  open -a "1Password"
  sleep 1.5
  osascript -e 'tell application "System Events" to keystroke "," using command down'

  echo "Click 'Developer' in the sidebar, then check the box for 'Use the SSH
  Agent'."

  read -r "?Press Return once you have enabled the setting to continue."

  if [ -S "$SOCKET" ]; then
    echo "1Password SSH Agent verified successfully!"
  else
    echo "1Password SSH socket still not found. You may need to restart or
    troubleshoot."
  fi
else
  echo "1Password SSH Agent is already active."
fi
