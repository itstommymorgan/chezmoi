#!/bin/bash

# 1Password first: `op` needs the desktop app running, and chezmoi reads secrets from it
# during apply (see run_before_25-ensure-1password.sh).
apps=(1Password Hammerspoon Notion Claude Raycast Karabiner-Elements Todoist AltTab)

for app in "${apps[@]}"; do
  echo "adding $app to login items..."
  loginitems -a "$app"
done
