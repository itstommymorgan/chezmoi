{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "right_control -> fn, so Wispr Flow's Fn hotkey works on the Keychron. The Keychron's own Fn is a firmware layer key that never reaches the host, so there is nothing there to bind. right_control doesn't exist on the MacBook's built-in keyboard, so this needs no device scoping. Must stay ahead of the return_or_enter rule below: that rule *emits* right_control for the arrow layer, and a later rule would swallow it.",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "right_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "fn" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change caps_lock to left_control if pressed with other keys, change caps_lock to escape if pressed alone.",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic",
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 200 }
                            }
                        ]
                    },
                    {
                        "description": "Change right_command to command+control+option+shift (the hyper key every Hammerspoon binding hangs off) if pressed with other keys, hyper+space if pressed alone -- which is MicMute.spoon's toggle in dot_hammerspoon/init.lua.",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["left_command", "left_control", "left_option", "left_shift"]
                                    }
                                ],
                                "type": "basic",
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 200 }
                            }
                        ]
                    },
                    {
                        "description": "Change left_shift to ( and right_shift to ) when pressed alone.",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_shift", "modifiers": ["left_shift"] }],
                                "to_if_alone": [{ "key_code": "9", "modifiers": ["left_shift"] }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "right_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "right_shift", "modifiers": ["right_shift"] }],
                                "to_if_alone": [{ "key_code": "0", "modifiers": ["right_shift"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change return_or_enter to right_option+right_control if pressed with other keys (arrow-key layer via h/j/k/l), return_or_enter if pressed alone.",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "right_control", "modifiers": ["right_option"] }],
                                "to_if_alone": [{ "key_code": "return_or_enter" }],
                                "type": "basic",
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 200 }
                            },
                            {
                                "description": "Return-held + h = left_arrow",
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "left_arrow" }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + j = down_arrow",
                                "from": {
                                    "key_code": "j",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "down_arrow" }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + k = up_arrow",
                                "from": {
                                    "key_code": "k",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "up_arrow" }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + l = right_arrow",
                                "from": {
                                    "key_code": "l",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + o = shift+return (newline without submitting)",
                                "from": {
                                    "key_code": "o",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "return_or_enter", "modifiers": ["left_shift"] }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Return-held + a/s/d/f = bracket layer ( [ ] { } ). Rides the same right_option+right_control modifier the return_or_enter rule emits, so it must stay after that rule.",
                        "manipulators": [
                            {
                                "description": "Return-held + a = [",
                                "from": {
                                    "key_code": "a",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "open_bracket" }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + s = ]",
                                "from": {
                                    "key_code": "s",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "close_bracket" }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + d = {",
                                "from": {
                                    "key_code": "d",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "open_bracket", "modifiers": ["left_shift"] }],
                                "type": "basic"
                            },
                            {
                                "description": "Return-held + f = }",
                                "from": {
                                    "key_code": "f",
                                    "modifiers": { "mandatory": ["right_option", "right_control"] }
                                },
                                "to": [{ "key_code": "close_bracket", "modifiers": ["left_shift"] }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "fn_function_keys": [
                {
                    "from": { "key_code": "f6" },
                    "to": [{ "key_code": "f6" }]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "country_code": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
