theme = Dracula

# Ghostty only exposes the Mono variant of the Nerd Font patch.
font-family = FiraCode Nerd Font Mono
font-size = 16
# ss02 <= >=, ss06 \\, ss07 =~ !~, zero slashed 0
font-feature = ss02, ss06, ss07, zero

# At zero padding the top-left cell hugs the frame and the rounded window
# corner clips it. Balance spreads the leftover sub-cell space across edges.
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
# No titlebar; window still resizable.
# Costs titlebar dragging -- use option+click on the frame instead.
macos-titlebar-style = hidden

# Homebrew owns the cask, so Sparkle shouldn't update it out from under brew.
auto-update = off

# Option as Alt so zsh word motions (alt+b/alt+f) reach the shell.
macos-option-as-alt = true
window-save-state = always
confirm-close-surface = false
mouse-hide-while-typing = true

# Leader is ctrl+space (caps is remapped to ctrl); everything else hangs off it.
keybind = ctrl+space>v=new_split:right
keybind = ctrl+space>s=new_split:down
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>z=toggle_split_zoom
keybind = ctrl+space>e=equalize_splits
keybind = ctrl+space>q=close_surface
# Short scratch strip along the bottom; resize is in pixels, not lines.
keybind = ctrl+space>b=new_split:down
keybind = chain=resize_split:down,300
