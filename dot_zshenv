export ZSH="$HOME/.zsh"

# Why do I do all this? Sigh. The short version is that if I'm starting zsh in
# a login shell, then my .zshrc file is the best place to setup homebrew - it's
# after the OS does all of its default pathing stuff (in /etc/zprofile). If it's
# NOT a login shell, however, .zshrc doesn't get loaded - so I need to do
# it in .zshenv in order to make sure we have the right path order in place (otherwise
# scripts start to fail).
__tm_setup_homebrew() {
  # path_helper (which brew shellenv used to call) deduplicated PATH as a side
  # effect; -U keeps that property for free and applies to every later change.
  typeset -gU path PATH fpath FPATH

  export BREW_ROOT="/usr/local"
  # $CPUTYPE is a zsh builtin; `uname -m` would fork.
  if [[ $CPUTYPE == 'arm64' ]]; then
    export BREW_ROOT="/opt/homebrew"
  fi

  # Inlined `brew shellenv`. That call forks twice (it shells out to path_helper)
  # to print a string that only depends on BREW_ROOT, and this runs for every zsh
  # invocation including non-interactive ones. Verified to produce a byte-identical
  # PATH; re-check against `brew shellenv` output after a major Homebrew bump.
  export HOMEBREW_PREFIX="$BREW_ROOT"
  export HOMEBREW_CELLAR="$BREW_ROOT/Cellar"
  export HOMEBREW_REPOSITORY="$BREW_ROOT"
  export PATH="$BREW_ROOT/bin:$BREW_ROOT/sbin${PATH+:$PATH}"
  [[ -z "${MANPATH-}" ]] || export MANPATH=":${MANPATH#:}"
  export INFOPATH="$BREW_ROOT/share/info:${INFOPATH:-}"
  fpath[1,0]="$BREW_ROOT/share/zsh/site-functions"
  export FPATH
}

if [[ ! -o interactive ]]; then
  __tm_setup_homebrew
  eval "$(mise activate zsh --shims)"
fi
